+/* ANGLE's per-thread egl::Thread pthread key is the object that dies across a
+ * content close. A
+ * LIVE key round-trips a value; a dead one silently drops it, because
+ * pthread_setspecific on an invalid key is a no-op with the ASSERT compiled out.
+ * The index also tells us whether key slots are being recycled: if `nextkey`
+ * comes back LOWER after a close than it was before, the core's teardown freed
+ * indices and the -DNO_DLCLOSE prevention is confirmed on device. Costs one key,
+ * created and destroyed immediately, twice per content session. */
+static void ra_angle_keyprobe(const char *phase)
+{
+   pthread_key_t k  = 0;
+   void         *rt = (void*)-1;
+   char _m[192];
+   extern void RA_BeaconMark(const char *);
+
+   if (pthread_key_create(&k, NULL) == 0)
+   {
+      pthread_setspecific(k, (void*)0xA11CE);
+      rt = pthread_getspecific(k);
+      pthread_key_delete(k);
+   }
+   snprintf(_m, sizeof(_m),
+         "angle %s: cur=%p keyprobe=%p (want 0xa11ce) nextkey=%u",
+         phase, (void*)eglGetCurrentContext(), rt, (unsigned)k);
+   RA_BeaconMark(_m);
+}
+
+/* Widescreen diagnosis (the tester: SM64 letterboxed with rainbow bars, while the
+ * harness exonerated the core —). Logs
+ * the drawable the ANGLE surface actually has, the viewport RetroArch computed
+ * inside it, and both aspect numbers. Change-gated, so a steady session prints
+ * one line and a resize or aspect change prints one more. */
+static void ra_angle_vp_beacon(unsigned draw_w, unsigned draw_h)
+{
+   static unsigned last[6];
+   static float    last_ar, last_gar;
+   video_viewport_t vp;
+   float ar, gar = 0.0f;
+   video_driver_state_t *vst = video_state_get_ptr();
+   char _m[256];
+   extern void RA_BeaconMark(const char *);
+
+   memset(&vp, 0, sizeof(vp));
+   if (!video_driver_get_viewport_info(&vp))
+      return;
+   ar  = video_driver_get_aspect_ratio();
+   if (vst)
+      gar = vst->av_info.geometry.aspect_ratio;
+
+   if (   last[0] == draw_w && last[1] == draw_h
+       && last[2] == (unsigned)vp.x && last[3] == (unsigned)vp.y
+       && last[4] == vp.width && last[5] == vp.height
+       && last_ar == ar && last_gar == gar)
+      return;
+   last[0] = draw_w; last[1] = draw_h;
+   last[2] = (unsigned)vp.x; last[3] = (unsigned)vp.y;
+   last[4] = vp.width; last[5] = vp.height;
+   last_ar = ar; last_gar = gar;
+
+   snprintf(_m, sizeof(_m),
+         "angle vp: drawable=%ux%u vp=%d,%d %ux%u full=%ux%u ar=%.4f geom_ar=%.4f",
+         draw_w, draw_h, vp.x, vp.y, vp.width, vp.height,
+         vp.full_width, vp.full_height, ar, gar);
+   RA_BeaconMark(_m);
+}
