+}
+
+static bool cocoa_angle_gfx_ctx_set_video_mode(void *data,
+      unsigned width, unsigned height, bool fullscreen)
+{
+#if TARGET_OS_VISION
+   /* Pairs with the "angle close" probe: a nextkey that came DOWN across the
+    * close means indices were recycled by the core teardown. */
+   ra_angle_keyprobe("load");
+#endif
+   struct retro_hw_render_callback *hwr = video_driver_get_hw_context();
+   cocoa_angle_ctx_data_t *cocoa_ctx    = (cocoa_angle_ctx_data_t*)data;
+   cocoa_angle_view_args_t view_args    = {0};
+   EGLint major = 0, minor = 0, n = 0;
+   EGLint attribs[] = {
+      EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT_KHR,
+      EGL_SURFACE_TYPE,    EGL_WINDOW_BIT,
+      EGL_RED_SIZE,        8,
+      EGL_GREEN_SIZE,      8,
+      EGL_BLUE_SIZE,       8,
+      EGL_ALPHA_SIZE,      8,   /* round-8 tried 0 (compositor theory, disproven) — reverted (A-) */
+      EGL_DEPTH_SIZE,      0,
+      EGL_NONE
+   };
+   EGLint ctx_attribs[] = {
+      EGL_CONTEXT_CLIENT_VERSION, 3,
+      EGL_NONE
+   };
+
+   if (!cocoa_ctx)
+      return false;
+
+   if (!cocoa_angle_es3)
+   {
+      attribs[1]     = EGL_OPENGL_ES2_BIT;
+      ctx_attribs[1] = 2;
+   }
+
+   cocoa_main_thread_sync(cocoa_angle_prepare_view_mainthread, &view_args);
+
+   if (!view_args.layer)
+   {
+      RARCH_ERR("[ANGLE-Cocoa] No CAMetalLayer render surface available.\n");
+      return false;
+   }
+
+   /* Persistent display+context (s_egl): created once per process, never
+    * terminated.  Per content load we (re)create ONLY the window surface.
+    * egl_create_surface destroys any old surface first, then creates the new
+    * one and makes it current (egl_common.c:690-710) — the whole per-content
+    * story, with no display/context churn to dangle ANGLE's thread state.
+    * */
+   if (s_egl.dpy && s_egl.ctx)
+   {
+      {
+         char _m[176];
+         extern void RA_BeaconMark(const char *);
+         snprintf(_m, sizeof(_m),
+               "angle reuse: layer=%p cached=%p surf=%p cur=%p",
+               view_args.layer, s_egl_layer, (void*)s_egl.surf,
+               (void*)eglGetCurrentContext());
+         RA_BeaconMark(_m);
+      }
+      /* Singleton view => same CAMetalLayer as before => the surface is still
+       * valid; just re-make-current it, destroy nothing. */
+      if (s_egl.surf != EGL_NO_SURFACE && view_args.layer == s_egl_layer)
+      {
+         if (!cocoa_angle_make_current(s_egl.ctx))
+         {
+            egl_report_error();
+            RARCH_ERR("[ANGLE-Cocoa] Failed to re-make-current the reused surface.\n");
+            return false;
+         }
+      }
+      /* Defensive: layer identity changed (should not happen post-singleton) —
+       * rebuild the surface on the new layer. */
+      else
+      {
+         if (!egl_create_surface(&s_egl, view_args.layer))
+         {
+            egl_report_error();
+            RARCH_ERR("[ANGLE-Cocoa] Failed to recreate EGL surface on CAMetalLayer.\n");
+            return false;
+         }
+         s_egl_layer = view_args.layer;
+      }
+      egl_get_video_size(&s_egl, &cocoa_ctx->width, &cocoa_ctx->height);
+      if (!cocoa_ctx->width || !cocoa_ctx->height)
+      {
+         cocoa_ctx->width  = view_args.width;
+         cocoa_ctx->height = view_args.height;
+      }
+      egl_set_swap_interval(&s_egl, cocoa_ctx->swap_interval);
+      RARCH_LOG("[ANGLE-Cocoa] Surface %ux%u ready (reused).\n",
+            cocoa_ctx->width, cocoa_ctx->height);
+      return true;
+   }
+
+   /* First time in this process: full display/config/context init into s_egl. */
+   egl_init_dll();
+
+   if (!egl_init_context(&s_egl, EGL_NONE,
+            (void*)EGL_DEFAULT_DISPLAY, &major, &minor, &n, attribs, NULL))
+   {
+      egl_report_error();
+      RARCH_ERR("[ANGLE-Cocoa] Failed to initialize EGL display/config.\n");
+      return false;
+   }
+
+   RARCH_LOG("[ANGLE-Cocoa] EGL %d.%d initialized (%s).\n",
+         (int)major, (int)minor, cocoa_angle_es3 ? "ES3" : "ES2");
+
+#if TARGET_OS_VISION
+   /* Must be after eglInitialize and before any context exists. */
+   ra_blob_cache_install(s_egl.dpy);
+#endif
+
+   s_egl.use_hw_ctx =
+         hwr && (hwr->context_type != RETRO_HW_CONTEXT_NONE);
+
+   if (!egl_create_context(&s_egl, ctx_attribs))
+   {
+      egl_report_error();
+      RARCH_ERR("[ANGLE-Cocoa] Failed to create EGL context.\n");
+      goto error;
+   }
+
+   if (!egl_create_surface(&s_egl, view_args.layer))
+   {
+      egl_report_error();
+      RARCH_ERR("[ANGLE-Cocoa] Failed to create EGL window surface on CAMetalLayer.\n");
+      goto error;
+   }
+   s_egl_layer = view_args.layer;   /* reuse-identity for subsequent loads */
+
+   egl_get_video_size(&s_egl,
+         &cocoa_ctx->width, &cocoa_ctx->height);
+   if (!cocoa_ctx->width || !cocoa_ctx->height)
+   {
+      cocoa_ctx->width  = view_args.width;
+      cocoa_ctx->height = view_args.height;
+   }
+
+   egl_set_swap_interval(&s_egl, cocoa_ctx->swap_interval);
+
+   RARCH_LOG("[ANGLE-Cocoa] Surface %ux%u ready.\n",
+         cocoa_ctx->width, cocoa_ctx->height);
+
+   return true;
+
+error:
+   /* Surface creation failed — drop just the surface; the display/context stay
+    * standing (known-good once created) for the next attempt.  Never terminate.
+    * */
+   egl_destroy_surface(&s_egl);
+   return false;
+}
+
+static void cocoa_angle_gfx_ctx_get_video_size(void *data,
+      unsigned *width, unsigned *height)
+{
+   cocoa_angle_ctx_data_t *cocoa_ctx = (cocoa_angle_ctx_data_t*)data;
+
+   if (!cocoa_ctx)
+   {
+      *width  = 0;
+      *height = 0;
+      return;
+   }
+
+   if (s_egl.dpy && s_egl.surf)
+      egl_get_video_size(&s_egl, width, height);
+   else
+   {
+      *width  = cocoa_ctx->width;
+      *height = cocoa_ctx->height;
+   }
+}
+
+static void cocoa_angle_gfx_ctx_check_window(void *data, bool *quit,
+      bool *resize, unsigned *width, unsigned *height)
+{
+   unsigned new_width  = 0;
+   unsigned new_height = 0;
+   cocoa_angle_ctx_data_t *cocoa_ctx = (cocoa_angle_ctx_data_t*)data;
+
+   *quit = false;
+
+   if (!cocoa_ctx)
+      return;
+
+   cocoa_angle_gfx_ctx_get_video_size(data, &new_width, &new_height);
+   if (     new_width  && new_height
+         && (new_width != *width || new_height != *height))
+   {
+      *width  = new_width;
+      *height = new_height;
+      *resize = true;
+      cocoa_ctx->width  = new_width;
+      cocoa_ctx->height = new_height;
+   }
+}
+
+static bool cocoa_angle_gfx_ctx_set_resize(void *data,
+      unsigned width, unsigned height) { return false; }
+
+static void cocoa_angle_gfx_ctx_input_driver(void *data,
+      const char *joypad_name,
+      input_driver_t **input, void **input_data)
+{
+   *input      = NULL;
+   *input_data = NULL;
+}
+
+static bool cocoa_angle_gfx_ctx_suppress_screensaver(void *data,
+      bool enable) { return false; }
+
+static void cocoa_angle_gfx_ctx_swap_buffers(void *data)
+{
+   cocoa_angle_ctx_data_t *cocoa_ctx = (cocoa_angle_ctx_data_t*)data;
+
+   if (cocoa_ctx && s_egl.dpy)
+   {
+#if TARGET_OS_VISION
+      uint64_t t0 = mach_absolute_time();
+      egl_swap_buffers(&s_egl);
+      ra_pace_swap_note(mach_absolute_time() - t0);
+      ra_angle_vp_beacon(cocoa_ctx->width, cocoa_ctx->height);
+#else
+      egl_swap_buffers(&s_egl);
+#endif
+   }
+}
+
+static void cocoa_angle_gfx_ctx_bind_hw_render(void *data, bool enable)
+{
+   cocoa_angle_ctx_data_t *cocoa_ctx = (cocoa_angle_ctx_data_t*)data;
+
+   if (cocoa_ctx && s_egl.dpy)
+   {
+      /* Was egl_bind_hw_render(), which always calls eglMakeCurrent. Same
+       * semantics minus the redundant sync-bearing calls. */
+      s_egl.use_hw_ctx = enable;
+      if (s_egl.surf != EGL_NO_SURFACE)
+         cocoa_angle_make_current(enable ? s_egl.hw_ctx : s_egl.ctx);
+   }
+}
+
+static uint32_t cocoa_angle_gfx_ctx_get_flags(void *data)
+{
+   uint32_t flags = 0;
+#ifdef HAVE_GLSL
+   BIT32_SET(flags, GFX_CTX_FLAGS_SHADERS_GLSL);
+#endif
+   return flags;
+}
+
+static void cocoa_angle_gfx_ctx_set_flags(void *data, uint32_t flags) { }
+
+static float cocoa_angle_gfx_ctx_get_refresh_rate(void *data)
+{
+   return cocoa_get_refresh_rate();
+}
+
+const gfx_ctx_driver_t gfx_ctx_cocoa_angle = {
+   cocoa_angle_gfx_ctx_init,
+   cocoa_angle_gfx_ctx_destroy,
+   cocoa_angle_gfx_ctx_get_api,
+   cocoa_angle_gfx_ctx_bind_api,
+   cocoa_angle_gfx_ctx_set_swap_interval,
+   cocoa_angle_gfx_ctx_set_video_mode,
+   cocoa_angle_gfx_ctx_get_video_size,
+   cocoa_angle_gfx_ctx_get_refresh_rate,
+   NULL, /* get_video_output_size */
+   NULL, /* get_video_output_prev */
+   NULL, /* get_video_output_next */
+   cocoa_get_metrics,
+   NULL, /* translate_aspect */
+   NULL, /* update_title */
+   cocoa_angle_gfx_ctx_check_window,
+   cocoa_angle_gfx_ctx_set_resize,
+   cocoa_has_focus,
+   cocoa_angle_gfx_ctx_suppress_screensaver,
+   false, /* has_windowed */
+   cocoa_angle_gfx_ctx_swap_buffers,
+   cocoa_angle_gfx_ctx_input_driver,
+#ifdef HAVE_EGL
+   egl_get_proc_address,
+#else
+   NULL,
+#endif
+   NULL, /* image_buffer_init */
+   NULL, /* image_buffer_write */
+   NULL, /* show_mouse */
+   "cocoa-angle",
+   cocoa_angle_gfx_ctx_get_flags,
+   cocoa_angle_gfx_ctx_set_flags,
+   cocoa_angle_gfx_ctx_bind_hw_render,
+   NULL, /* get_context_data */
+   NULL, /* make_current */
+   NULL, /* create_surface */
+   NULL  /* destroy_surface */
+};
