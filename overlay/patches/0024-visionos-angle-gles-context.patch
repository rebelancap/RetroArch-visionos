+static void cocoa_angle_gfx_ctx_set_swap_interval(void *data,
+      int swap_interval)
+{
+   cocoa_angle_ctx_data_t *cocoa_ctx = (cocoa_angle_ctx_data_t*)data;
+
+   if (!cocoa_ctx)
+      return;
+
+   cocoa_ctx->swap_interval = swap_interval;
+   if (s_egl.dpy)
