+/* ---------------------------------------------------------- blob cache -----
+ * EGL_ANDROID_blob_cache: ANGLE calls these to persist its internal shader /
+ * program blobs. Without them every process lifetime retranslates GLSL->MSL and
+ * recompiles through Metal from cold, which is what a level load is doing
+ * during the black screen. Wiring measured in the macOS harness
+ * GoldenEye writes 23
+ * blobs / 155 KB cold, then a warm run is 24/24 hits and 0 sets. It bought no
+ * measurable load time on an M4 Pro (~4 ms off the worst frame), so it ships as
+ * a cheap bet on the headset's much slower Metal compiler — NOT as a promise.
+ *
+ * Callbacks are ported verbatim from the harness host. EGLsizeiANDROID is
+ * khronos_ssize_t == long. `get` must return the blob's REAL size and fill the
+ * buffer only when it fits; ANGLE re-calls with a bigger one. Must be installed
+ * after eglInitialize and before any context exists. */
+#include <sys/stat.h>
+#include <dirent.h>
+#include <errno.h>
+#include <pthread.h>
+
+typedef long RA_EGLsizeiANDROID;
+
+static char s_blob_dir[1024];
+
+static void ra_blob_path(char *out, size_t n, const void *key, RA_EGLsizeiANDROID ks)
+{
+   size_t pos = 0;
+   const unsigned char *k = (const unsigned char*)key;
+   if (ks > 0 && ks <= 96)
+   {
+      RA_EGLsizeiANDROID i;
+      pos = (size_t)snprintf(out, n, "%s/", s_blob_dir);
+      for (i = 0; i < ks && pos + 3 < n; i++)
+         pos += (size_t)snprintf(out + pos, n - pos, "%02x", k[i]);
+      snprintf(out + pos, n - pos, ".bin");
+   }
+   else
+   {
+      RA_EGLsizeiANDROID i;
+      uint64_t h = 1469598103934665603ull;
+      for (i = 0; i < ks; i++) { h ^= k[i]; h *= 1099511628211ull; }
+      snprintf(out, n, "%s/h%016llx-%ld.bin", s_blob_dir,
+            (unsigned long long)h, (long)ks);
+   }
+}
+
+static void ra_blob_set(const void *key, RA_EGLsizeiANDROID ks,
+      const void *value, RA_EGLsizeiANDROID vs)
+{
+   char path[2048];
+   FILE *f;
+   if (!s_blob_dir[0] || ks <= 0 || vs <= 0)
+      return;
+   ra_blob_path(path, sizeof(path), key, ks);
+   if (!(f = fopen(path, "wb")))
+      return;
+   fwrite(value, 1, (size_t)vs, f);
+   fclose(f);
+}
+
+static RA_EGLsizeiANDROID ra_blob_get(const void *key, RA_EGLsizeiANDROID ks,
+      void *value, RA_EGLsizeiANDROID vs)
+{
+   char path[2048];
+   FILE *f;
+   long  sz;
+   if (!s_blob_dir[0] || ks <= 0)
+      return 0;
+   ra_blob_path(path, sizeof(path), key, ks);
+   if (!(f = fopen(path, "rb")))
+      return 0;
+   fseek(f, 0, SEEK_END); sz = ftell(f); fseek(f, 0, SEEK_SET);
+   if (sz > 0 && vs >= sz)
+   {
+      if (fread(value, 1, (size_t)sz, f) != (size_t)sz)
+         sz = 0;
+   }
+   fclose(f);
+   return (RA_EGLsizeiANDROID)sz;
+}
+
+/* Keep the directory bounded: one pass at startup, oldest-first, down to 64 MB.
+ * Blobs are pure cache — deleting one costs a recompile, never user data. */
+#define RA_BLOB_CACHE_MAX_BYTES (64u * 1024u * 1024u)
+
+static void ra_blob_prune(void)
+{
+   struct entry { char name[256]; time_t mtime; off_t size; };
+   struct entry *list = NULL;
+   size_t n = 0, cap = 0;
+   unsigned long long total = 0;
+   DIR *d = opendir(s_blob_dir);
+   struct dirent *de;
+   size_t i, j;
+
+   if (!d)
+      return;
+   while ((de = readdir(d)))
+   {
+      char p[2048];
+      struct stat st;
+      if (de->d_name[0] == '.')
+         continue;
+      snprintf(p, sizeof(p), "%s/%s", s_blob_dir, de->d_name);
+      if (stat(p, &st) != 0 || !S_ISREG(st.st_mode))
+         continue;
+      if (n == cap)
+      {
+         struct entry *nl;
+         cap = cap ? cap * 2 : 128;
+         if (!(nl = (struct entry*)realloc(list, cap * sizeof(*list))))
+            break;
+         list = nl;
+      }
+      strlcpy(list[n].name, de->d_name, sizeof(list[n].name));
+      list[n].mtime = st.st_mtime;
+      list[n].size  = st.st_size;
+      total += (unsigned long long)st.st_size;
+      n++;
+   }
+   closedir(d);
+
+   if (total > RA_BLOB_CACHE_MAX_BYTES)
+   {
+      /* Insertion sort, oldest first. n is in the hundreds at most. */
+      for (i = 1; i < n; i++)
+      {
+         struct entry tmp = list[i];
+         for (j = i; j > 0 && list[j - 1].mtime > tmp.mtime; j--)
+            list[j] = list[j - 1];
+         list[j] = tmp;
+      }
+      for (i = 0; i < n && total > RA_BLOB_CACHE_MAX_BYTES; i++)
+      {
+         char p[2048];
+         snprintf(p, sizeof(p), "%s/%s", s_blob_dir, list[i].name);
+         if (remove(p) == 0)
+            total -= (unsigned long long)list[i].size;
+      }
+   }
+   free(list);
+}
+
+/* Install right after eglInitialize, before any context is created. */
+static void ra_blob_cache_install(EGLDisplay dpy)
+{
+   typedef void (*setfuncs_t)(EGLDisplay,
+         void (*)(const void*, RA_EGLsizeiANDROID, const void*, RA_EGLsizeiANDROID),
+         RA_EGLsizeiANDROID (*)(const void*, RA_EGLsizeiANDROID, void*, RA_EGLsizeiANDROID));
+   setfuncs_t setfuncs;
+   const char *home = getenv("HOME");
+   char _m[320];
+   extern void RA_BeaconMark(const char *);
+
+   if (!home || !dpy)
+      return;
+
+   snprintf(s_blob_dir, sizeof(s_blob_dir), "%s/Documents/RetroArch/cache", home);
+   mkdir(s_blob_dir, 0755);   /* Documents/RetroArch already exists by now */
+   snprintf(s_blob_dir, sizeof(s_blob_dir),
+         "%s/Documents/RetroArch/cache/angle-blob", home);
+   if (mkdir(s_blob_dir, 0755) != 0 && errno != EEXIST)
+   {
+      s_blob_dir[0] = '\0';
+      return;
+   }
+   ra_blob_prune();
+
+   setfuncs = (setfuncs_t)eglGetProcAddress("eglSetBlobCacheFuncsANDROID");
+   if (!setfuncs)
+   {
+      s_blob_dir[0] = '\0';
+      RA_BeaconMark("angle blob cache: eglSetBlobCacheFuncsANDROID NOT FOUND");
+      return;
+   }
+   setfuncs(dpy, ra_blob_set, ra_blob_get);
+   snprintf(_m, sizeof(_m), "angle blob cache armed: %s", s_blob_dir);
+   RA_BeaconMark(_m);
+}
+#endif
