+/* 0033 pacing: split the swap wait out of the measured iterate() time, so the
+ * 2s pace line can say whether an expensive frame is real work or a block
+ * inside eglSwapBuffers. Defined in ui/drivers/cocoa/cocoa_common.m. */
+#include <mach/mach_time.h>
+void ra_pace_swap_note(uint64_t mach_delta);
