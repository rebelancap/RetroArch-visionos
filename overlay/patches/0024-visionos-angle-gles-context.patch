+#ifndef EGL_OPENGL_ES3_BIT_KHR
+#define EGL_OPENGL_ES3_BIT_KHR 0x0040
+#endif
+
+typedef struct
+{
+   int swap_interval;
+   unsigned width;
+   unsigned height;
+} cocoa_angle_ctx_data_t;
+
+/* TODO/FIXME - static globals (same pattern as the other cocoa contexts) */
+static bool cocoa_angle_es3 = true;
+
+/* EGL display+context persist for the app's lifetime.  ANGLE must NEVER be
+ * terminated mid-process: the terminate/re-init cycle (egl_destroy ->
+ * eglTerminate on every content close) dangles ANGLE's per-thread context
+ * state and crashes the next eglMakeCurrent — and even eglReleaseThread —
+ * with a ScopedSyncCurrentContextFromThread UAF (was deterministic on the 2nd
+ * N64 load).  Only the window surface is per-content; we recreate just that.
+ * This is how ANGLE is used in production (WebKit inits the display once and
+ * never terminates it). */
+static egl_ctx_data_t s_egl;   /* zero-init: dpy == EGL_NO_DISPLAY */
+/* Identity of the CAMetalLayer s_egl's surface is bound to.  With the ANGLE view
+ * now an app-lifetime singleton (ui_cocoatouch setViewType), this never changes
+ * after first init, so on re-entry we re-make-current the existing surface
+ * instead of destroying/recreating it — nothing ANGLE's thread references ever
+ * dies. */
+static void *s_egl_layer;      /* identity only; the singleton view owns the layer */
+
+CocoaView *cocoaview_get(void);
+/* Defined in ui/drivers/cocoa/cocoa_common.m (same declared-locally pattern
+ * as cocoa_vk_ctx.m, avoiding edits to the CRLF-formatted cocoa_common.h). */
+void cocoa_main_thread_sync(void (*func)(void *userdata), void *userdata);
+
+static CAMetalLayer *cocoa_angle_layer(void)
+{
+   UIView *v = (UIView *)apple_platform.renderView;
+   if ([v isKindOfClass:[MetalLayerView class]])
+      return ((MetalLayerView *)v).metalLayer;
+   return nil;
+}
+
+/* -- UIKit portion of set_video_mode; must run on the main thread -- */
+typedef struct
+{
+   void       *layer;   /* out: CAMetalLayer* (unretained)   */
+   unsigned    width;   /* out: layer size in device pixels  */
+   unsigned    height;
+} cocoa_angle_view_args_t;
+
+static void cocoa_angle_prepare_view_mainthread(void *userdata)
+{
+   cocoa_angle_view_args_t *args = (cocoa_angle_view_args_t*)userdata;
+   CAMetalLayer *layer           = NULL;
+
+   /* Creates/attaches the MetalLayerView render surface (see the
+    * TARGET_OS_VISION branch of setViewType:).  Idempotent when already
+    * the active view type. */
+   [apple_platform setViewType:APPLE_VIEW_TYPE_OPENGL_ES];
+
+   layer = cocoa_angle_layer();
+   if (layer)
+   {
+      CGSize  b     = layer.bounds.size;
+      CGFloat scale = layer.contentsScale > 0.0 ? layer.contentsScale : 1.0;
+      /* (round-8 set layer.opaque=YES on the compositor-punch-through theory;
+       * disproven on device and a suspect in the 59->45fps regression, so
+       * reverted to the CAMetalLayer default here — A-.) */
+      args->layer   = (BRIDGE void *)layer;
+      args->width   = (unsigned)(b.width  * scale);
+      args->height  = (unsigned)(b.height * scale);
+   }
+   else
+   {
+      args->layer  = NULL;
+      args->width  = 0;
+      args->height = 0;
+   }
+}
+
+/* eglGetCurrentDisplay/Context/Surface do NOT construct
+ * ScopedSyncCurrentContextFromThread (egl_stubs.cpp:410-436) — they are plain
+ * reads of the thread's state, so they stay safe even where eglMakeCurrent
+ * would fault. Used here to skip make-current whenever the binding already is
+ * what we want, which on the reload path is always. */
+static bool cocoa_angle_already_current(EGLContext want)
+{
+   return    eglGetCurrentDisplay()         == s_egl.dpy
+          && eglGetCurrentContext()         == want
+          && eglGetCurrentSurface(EGL_DRAW) == s_egl.surf
+          && eglGetCurrentSurface(EGL_READ) == s_egl.surf;
+}
+
+static bool cocoa_angle_make_current(EGLContext want)
+{
+   if (cocoa_angle_already_current(want))
+      return true;
+   return eglMakeCurrent(s_egl.dpy, s_egl.surf, s_egl.surf, want);
+}
+
+static void cocoa_angle_gfx_ctx_destroy(void *data)
+{
+   cocoa_angle_ctx_data_t *cocoa_ctx = (cocoa_angle_ctx_data_t*)data;
+
+   if (!cocoa_ctx)
+      return;
+
+   /* Content close: touch NOTHING. The display, context, surface and the
+    * singleton MetalLayerView/CAMetalLayer are all app-lifetime, so the
+    * binding stays valid across the metal-menu period.
+    *
+    * We deliberately no longer eglMakeCurrent(EGL_NO_*) here. eglMakeCurrent is
+    * one of only four EGL entry points that construct
+    * egl::ScopedSyncCurrentContextFromThread, whose destructor stores
+    * unconditionally through ANGLE's per-thread egl::Thread TLS slot
+    * (global_state.cpp:150 -> Thread::setCurrent, `str x1,[x0,#0x18]`, no null
+    * check, ASSERT compiled out). That store is the 2nd-load SIGSEGV.
+    * The stale object is ANGLE's thread TLS, not any handle we own, so the port
+    * cannot repair it — it can only stop issuing the call. Leaving the context
+    * current means the reload path issues no sync-bearing EGL call at all.
+    * */
+   if (s_egl.dpy)
+   {
+      char _m[176];
+      extern void RA_BeaconMark(const char *);
+      snprintf(_m, sizeof(_m),
+            "angle destroy keep-current: dpy=%p ctx=%p surf=%p cur=%p",
+            (void*)s_egl.dpy, (void*)s_egl.ctx, (void*)s_egl.surf,
+            (void*)eglGetCurrentContext());
+      RA_BeaconMark(_m);
+#if TARGET_OS_VISION
+      ra_angle_keyprobe("close");
+#endif
+   }
+   free(cocoa_ctx);
+}
+
+static void *cocoa_angle_gfx_ctx_init(void *video_driver)
+{
+   cocoa_angle_ctx_data_t *cocoa_ctx = (cocoa_angle_ctx_data_t*)
+      calloc(1, sizeof(*cocoa_ctx));
+
+   if (!cocoa_ctx)
+      return NULL;
+
+   return cocoa_ctx;
+}
