+/* ---- RA3D depth planes ------------------------------------------------------
+ * The visionOS shell places the picture's layers at different distances so the
+ * scene has real binocular depth.  It reads them straight out of the core by
+ * dlsym, so RetroArch's video path — and therefore ordinary 2D output — is
+ * untouched.
+ *
+ * SNES gives two planes rather than the NES's three: snes9x has no per-sprite
+ * "behind the background" bit exposed at this level, and the OBJ layer is
+ * composited as one unit.  Planes come back far to near:
+ *   planes[0] = everything except sprites  (from the OBJ-free second pass)
+ *   planes[1] = sprites alone              (where the normal composite differs)
+ * 256x239 ARGB8888, alpha 0 where nothing was drawn, owned by the core. */
+extern uint16 *ra3d_bg_screen;
+extern uint8  *ra3d_bg_zbuf;
+extern uint32 *ra3d_argb[2];
+extern uint32  ra3d_frame;
+extern bool8   ra3d_have;
+
+extern "C" int snes9x_ra3d_get_planes(const uint32_t **planes, unsigned *width,
+                                      unsigned *height, uint32_t *frame_counter,
+                                      float *display_aspect)
+{
+   if (!planes || !ra3d_have || !ra3d_argb[0] || !ra3d_argb[1] || !ra3d_bg_screen)
+      return 0;
+
+   /* Use the RENDERED size, not the nominal 256x224: in hi-res / pseudo-hires
+    * (mode 5/6, and plenty of title screens) snes9x renders 512 wide, and in
+    * interlace 448 tall.  Assuming 256 there takes the left half of every row
+    * and the picture comes out zoomed and cropped. */
+   const unsigned w = (unsigned)IPPU.RenderedScreenWidth;
+   const unsigned h = (unsigned)IPPU.RenderedScreenHeight;
+   if (w == 0 || h == 0 || w > MAX_SNES_WIDTH || h > MAX_SNES_HEIGHT)
+      return 0;
+
+   for (unsigned y = 0; y < h; y++)
+   {
+      const uint16 *comp = GFX.Screen        + y * GFX.RealPPL;  /* with sprites    */
+      const uint16 *bg   = ra3d_bg_screen    + y * GFX.RealPPL;  /* without sprites */
+      uint32       *o0   = ra3d_argb[0]      + y * w;
+      uint32       *o1   = ra3d_argb[1]      + y * w;
+      for (unsigned x = 0; x < w; x++)
+      {
+         /* 5-6-5 (or 5-5-5) to 8-8-8, replicating the high bits into the low
+          * ones so full-scale stays full-scale. */
+         /* Use snes9x's own unpacker rather than hand-rolled shifts: its 565
+          * layout is not the conventional one (green sits at shift 6), and
+          * getting it wrong tints the whole plane green. */
+         #define RA3D_TO_ARGB(px, out) do { \
+            uint8 _r, _g, _b; \
+            DECOMPOSE_PIXEL((px), _r, _g, _b); \
+            (out) = 0xFF000000u \
+                  | ((uint32)(_r * 255 / MAX_RED)   << 16) \
+                  | ((uint32)(_g * 255 / MAX_GREEN) <<  8) \
+                  |  (uint32)(_b * 255 / MAX_BLUE); \
+         } while (0)
+         uint16 c = comp[x], b = bg[x];
+         RA3D_TO_ARGB(b, o0[x]);
+         /* A sprite owns this pixel exactly where the two passes disagree. */
+         if (c != b) RA3D_TO_ARGB(c, o1[x]); else o1[x] = 0u;
+         #undef RA3D_TO_ARGB
+      }
+   }
+
+   planes[0] = ra3d_argb[0];
+   planes[1] = ra3d_argb[1];
+   if (width)  *width  = w;
+   if (height) *height = h;
+   if (frame_counter) *frame_counter = ++ra3d_frame;
+   /* The SNES displays 4:3 whether it rendered 256 or 512 across — hi-res
+    * doubles the sample count, not the picture's shape.  Report that directly
+    * so the shell never has to infer it from the plane dimensions or from the
+    * frontend's own aspect, which follows the rendered width and swings to
+    * ~2.28 in hi-res scenes. */
+   if (display_aspect) *display_aspect = 4.0f / 3.0f;
+   return 2;
+}
