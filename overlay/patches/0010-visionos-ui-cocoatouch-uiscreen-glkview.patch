+/* --- Remote-diagnosis floor -----
+ * Launch beacon + crash handler for OTA-only debugging: no debugger on the user's
+ * device, and RetroArch's own file log isn't up yet at launch. Writes to the app's
+ * Documents (Files-visible). Pure POSIX in the constructor (UIKit/Foundation are
+ * not safe pre-main). Always on and cheap; a crash at launch leaves crash.txt. */
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+#include <execinfo.h>
+#include <signal.h>
+
+static void ra_diag_write(const char *file, const char *msg, int append)
+{
+   const char *home = getenv("HOME");
+   if (!home) return;
+   char path[1024];
+   snprintf(path, sizeof path, "%s/Documents/%s", home, file);
+   int fd = open(path, O_WRONLY | O_CREAT | (append ? O_APPEND : O_TRUNC), 0644);
+   if (fd < 0) return;
+   time_t t = time(NULL); struct tm tmv; localtime_r(&t, &tmv);
+   char line[640];
+   int n = snprintf(line, sizeof line, "%04d-%02d-%02d %02d:%02d:%02d  %s\n",
+      tmv.tm_year+1900, tmv.tm_mon+1, tmv.tm_mday,
+      tmv.tm_hour, tmv.tm_min, tmv.tm_sec, msg);
+   if (n > 0) write(fd, line, (size_t)n);
+   close(fd);
+}
+
+void RA_BeaconMark(const char *stage) { ra_diag_write("launch-beacon.log", stage, 1); }
+
+__attribute__((constructor)) static void ra_launch_beacon(void)
+{
+   ra_diag_write("launch-beacon.log", "beacon: dyld image init (pre-main) - process spawned", 1);
+}
+
+static void ra_crash_dump(const char *reason)
+{
+   ra_diag_write("crash.txt", reason, 1);
+   const char *home = getenv("HOME");
+   if (!home) return;
+   char path[1024];
+   snprintf(path, sizeof path, "%s/Documents/crash.txt", home);
+   int fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0644);
+   if (fd < 0) return;
+   void *cb[64];
+   int  n = backtrace(cb, 64);
+   backtrace_symbols_fd(cb, n, fd);
+   write(fd, "\n", 1);
+   close(fd);
+}
+
+static void ra_signal_handler(int sig)
+{
+   /* Include the crashing thread's name + main-thread flag: distinguishes a
+    * main-thread fault from a Granite/MoltenVK worker (e.g. the FPS-font-pinch
+    * SIGSEGV in a std::thread teardown). */
+   char tn[64] = {0};
+   pthread_getname_np(pthread_self(), tn, sizeof tn);
+   char msg[160]; snprintf(msg, sizeof msg, "CRASH: signal %d [thread='%s' main=%d]",
+      sig, tn[0] ? tn : "?", (int)pthread_main_np());
+   ra_crash_dump(msg);
+   signal(sig, SIG_DFL); raise(sig);
+}
+
+static void ra_exception_handler(NSException *e)
+{
+   char msg[512]; snprintf(msg, sizeof msg, "CRASH: uncaught %s: %s",
+      e.name.UTF8String ? e.name.UTF8String : "?",
+      e.reason.UTF8String ? e.reason.UTF8String : "?");
+   ra_crash_dump(msg);
+}
+
+static void ra_install_crash_handlers(void)
+{
+   NSSetUncaughtExceptionHandler(&ra_exception_handler);
+   int sigs[] = { SIGABRT, SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGTRAP };
+   for (unsigned i = 0; i < sizeof(sigs)/sizeof(sigs[0]); i++)
+      signal(sigs[i], ra_signal_handler);
+}
+
+#if TARGET_OS_VISION
+/* --- visionOS window/drawable sizing (overlay patch 0015; WINDOW-ASPECT doc) ---
+ * cocoa_vision_update_drawable(): size the Metal drawable to a ~3840 long edge
+ * from the CURRENT view bounds (the patch 0010 formula), recomputed on every
+ * relayout so a resized / aspect-changed window keeps 4K fidelity.
+ * cocoa_vision_window_match_aspect(): request a window shaped to the applied
+ * content aspect so 4:3 content fills the plane with no pillarbox; user
+ * corner-drags stay ratio-locked. Called from video_driver_set_aspect_ratio(). */
+void cocoa_vision_update_drawable(void)
+{
+   UIView *rv = (UIView *)apple_platform.renderView;
+   if (!rv)
+      return;
+   CGFloat vw = rv.bounds.size.width, vh = rv.bounds.size.height;
+   if (MAX(vw, vh) < 1.0) { vw = 1280.0; vh = 720.0; }
+#if defined(RA_VISION_3D)
+   /* 3D theater: the render size is dictated by the panel, not by the parked
+    * control card's bounds.  Drive the MetalView's drawable straight to it so
+    * the driver's viewport and the offscreen ring always agree. */
+   if (ra_vision_3d_active() && [rv isKindOfClass:[MetalView class]])
+   {
+      unsigned tw = 0, th = 0;
+      ra_vision_3d_render_size(&tw, &th);
+      MetalView *mv3 = (MetalView *)rv;
+      CGSize     cur3 = mv3.drawableSize;
+      mv3.autoResizeDrawable = NO;
+      if (fabs(cur3.width - (CGFloat)tw) < 1.0 && fabs(cur3.height - (CGFloat)th) < 1.0)
+         return;
+      [mv3 setDrawableSize:CGSizeMake((CGFloat)tw, (CGFloat)th)];
+      { char _m[96]; snprintf(_m, sizeof _m, "visionOS 3D drawable %ux%u", tw, th);
+        RA_BeaconMark(_m); }
+      return;
+   }
+#endif
+   CGFloat scale = 3840.0 / MAX(vw, vh);
+   if (scale < 2.0) scale = 2.0;
+   CGSize dsz = CGSizeMake(vw * scale, vh * scale);
+   CGFloat dmax = MAX(dsz.width, dsz.height);
+   if (dmax > 4320.0) { CGFloat k = 4320.0 / dmax; dsz.width *= k; dsz.height *= k; }
+
+   /* Change-guard on both paths: this runs per-frame (rarch_draw_observer) and on
+    * every layout — only re-arm the drawable when the size actually changed. */
+   if ([rv isKindOfClass:[MetalView class]])              /* Metal cores */
+   {
+      MetalView *mv = (MetalView *)rv;
+      mv.autoResizeDrawable = NO;
+      CGSize cur = mv.drawableSize;
+      if (fabs(cur.width - dsz.width) < 1.0 && fabs(cur.height - dsz.height) < 1.0)
+         return;
+      [mv setDrawableSize:dsz];
+      { char _m[96]; snprintf(_m, sizeof _m, "visionOS drawable %.0fx%.0f (view pts %.0fx%.0f)",
+           dsz.width, dsz.height, vw, vh); RA_BeaconMark(_m); }
+   }
+#if defined(HAVE_VULKAN) || defined(HAVE_OPENGL)
+   else if ([rv isKindOfClass:[MetalLayerView class]])    /* N64: Vulkan OR ANGLE */
+   {
+      /* Both the Vulkan (ParaLLEl-RDP) and ANGLE (GLideN64) N64 paths render onto
+       * this MetalLayerView — but they take DIFFERENT size levers:
+       *   Vulkan: MoltenVK reads CAMetalLayer.drawableSize as the surface
+       *           currentExtent -> set drawableSize to ~4K.
+       *   ANGLE : SurfaceMtl derives drawable = bounds x contentsScale and REWRITES
+       *           drawableSize each present -> setting drawableSize is futile; drive
+       *           the layer's contentsScale instead (eglQuerySurface then reports 4K,
+       *           the round-4 reconcile handles the resize). */
+      CAMetalLayer *ml = ((MetalLayerView *)rv).metalLayer;
+      extern const char *video_driver_get_ident(void);
+      const char *vid = video_driver_get_ident();
+      bool is_gl = vid && vid[0] == 'g' && vid[1] == 'l';   /* gl/gles/glcore = ANGLE */
+      if (is_gl)
+      {
+         CGFloat le     = MAX(vw, vh);
+         CGFloat target = le > 1.0 ? (3840.0 / le) : 2.0;
+         if (target < 2.0) target = 2.0;                    /* never below system scale */
+         if (le * target > 4320.0) target = 4320.0 / le;    /* keep the 0010 cap */
+         if (fabs(ml.contentsScale - target) > 0.01)
+         {
+            ml.contentsScale = target;
+            char _m[96]; snprintf(_m, sizeof _m, "visionOS angle scale %.2f (view pts %.0fx%.0f)",
+                 target, vw, vh); RA_BeaconMark(_m);
+         }
+      }
+      else
+      {
+         CGSize cur = ml.drawableSize;
+         if (fabs(cur.width - dsz.width) < 1.0 && fabs(cur.height - dsz.height) < 1.0)
+            return;
+         ml.drawableSize = dsz;
+         char _m[96]; snprintf(_m, sizeof _m, "visionOS vk drawable %.0fx%.0f (view pts %.0fx%.0f)",
+              dsz.width, dsz.height, vw, vh); RA_BeaconMark(_m);
+      }
+   }
+#endif
+}
+
+void cocoa_vision_window_match_aspect(float aspect, unsigned rotation)
+{
+   if (aspect <= 0.0f)
+      return;
+#if defined(RA_VISION_3D)
+   /* In 3D theater the PANEL takes the content aspect, not the window: the
+    * screen keeps its user-set width and derives its height, so 4:3, NES 8:7
+    * and vertical arcade cabinets are each correctly shaped with no
+    * letterboxing — and the parked control card is left alone. */
+   ra_vision_3d_set_aspect(aspect, rotation);
+   if (ra_vision_3d_active())
+      return;
+#endif
+   if (rotation == 90 || rotation == 270)   /* vertical content (e.g. MAME shmup) */
+      aspect = 1.0f / aspect;
+   float a = aspect;
+   dispatch_async(dispatch_get_main_queue(), ^{
+      UIWindow *w       = [RetroArch_iOS get].window;
+      UIWindowScene *ws = w.windowScene;
+      if (!ws)
+         return;
+      CGFloat cw = w.bounds.size.width, ch = w.bounds.size.height;
+      CGFloat cur = (ch > 1.0) ? (cw / ch) : 0.0;
+      /* Compare the ACTUAL current window aspect (not a static) so we re-converge
+       * after a user corner-drag or an earlier request the system didn't honor.
+       * Skip only when the window already matches (within 2%). */
+      if (cur > 0.0f && fabsf(cur - a) < 0.02f) {
+         char _m[96]; snprintf(_m, sizeof _m, "aspect ok %.3f (win %.0fx%.0f)", a, cw, ch);
+         RA_BeaconMark(_m);
+         return;
+      }
+      CGFloat h = ch > 1.0 ? ch : 720.0;
+      UIWindowSceneGeometryPreferencesVision *p =
+         [[UIWindowSceneGeometryPreferencesVision alloc]
+            initWithSize:CGSizeMake(round(h * a), round(h))];
+      p.minimumSize          = CGSizeMake(320.0, 240.0);
+      p.resizingRestrictions = UIWindowSceneResizingRestrictionsUniform;
+      [ws requestGeometryUpdateWithPreferences:p errorHandler:^(NSError *e){
+         if (e) { char _m[160]; snprintf(_m, sizeof _m, "aspect geom ERROR: %s",
+              e.localizedDescription.UTF8String ? e.localizedDescription.UTF8String : "?");
+              RA_BeaconMark(_m); }
+      }];
+      char _m[112]; snprintf(_m, sizeof _m, "aspect req %.3f (cur %.3f, win %.0fx%.0f -> %.0fx%.0f)",
+           a, cur, cw, ch, round(h * a), round(h)); RA_BeaconMark(_m);
+   });
+}
+#endif
