 - (BOOL)acceptsFirstResponder { return YES; }
 - (BOOL)isFlipped { return YES; }
@@ -4303,8 +4411,28 @@ - (Uniforms *)viewportMVP { return &_viewportMVP; }
 - (void)mtkView:(MTKView *)view drawableSizeWillChange:(CGSize)size
 {
 #ifdef HAVE_COCOATOUCH
+#if TARGET_OS_VISION
+    /* visionOS: the drawable size is set directly (autoResizeDrawable=NO), so use
+     * the real drawable, not bounds x contentScaleFactor (contentScaleFactor is
+     * capped by the system and would under-size the viewport). */
+    CGSize d = view.drawableSize;
+    if (d.width < 1.0 || d.height < 1.0) d = size;
+    [self setViewportWidth:(unsigned int)d.width height:(unsigned int)d.height forceFull:NO allowRotate:YES];
+    /* 0019 verification beacon: fires only on a real drawable change (the
+     * update_drawable change-guard gates it). Confirms drawable->viewport with
+     * no side bars once the drawable tracks the window aspect. */
+    {
+       extern void RA_BeaconMark(const char *);
+       char _m[128];
+       snprintf(_m, sizeof _m, "drawable %.0fx%.0f -> vp %ux%u @%d,%d (full %ux%u)",
+                d.width, d.height, _viewport->width, _viewport->height,
+                _viewport->x, _viewport->y, _viewport->full_width, _viewport->full_height);
+       RA_BeaconMark(_m);
+    }
+#else
     CGFloat scale = [[UIScreen mainScreen] scale];
     [self setViewportWidth:(unsigned int)view.bounds.size.width*scale height:(unsigned int)view.bounds.size.height*scale forceFull:NO allowRotate:YES];
+#endif
 #else
    [self setViewportWidth:(unsigned int)size.width height:(unsigned int)size.height forceFull:NO allowRotate:YES];
 #endif
