    video_viewport_t _viewport;
    id<MTLSamplerState> _samplers[TEXTURE_FILTER_MIPMAP_NEAREST + 1];
    Filter *_filters[RPixelFormatCount]; /* convert to BGRA8888 */
@@ -1920,7 +1936,27 @@ - (Texture *)newTextureCompressed:(const struct texture_compressed *)tc
 - (id<CAMetalDrawable>)nextDrawable
 {
    if (_drawable == nil)
+   {
+#if defined(RA_VISION_3D)
+      /* 3D theater: hand back an offscreen stand-in.  This has to be the
+       * redirect point rather than a copy-out afterwards, because a window
+       * parked behind an open ImmersiveSpace stops vending drawables and this
+       * call BLOCKS for frame pacing — the emulator would hang the moment the
+       * space opened. */
+      if (ra_vision_3d_active())
+      {
+         int   slot = -1;
+         void *d    = ra_vision_offscreen_acquire((__bridge void *)_device,
+                                                  (unsigned)_layer.pixelFormat,
+                                                  &slot);
+         _offscreenSlot = slot;
+         _drawable      = (__bridge id<CAMetalDrawable>)d;
+         return _drawable;
+      }
+      _offscreenSlot = -1;
+#endif
       _drawable = _layer.nextDrawable;
+   }
    return _drawable;
 }
 
@@ -2259,6 +2295,19 @@ - (void)end
 
    id<CAMetalDrawable> drawable = self.nextDrawable;
 
+#if defined(RA_VISION_3D)
+   if (ra_vision_3d_active() && _offscreenSlot >= 0)
+   {
+      /* Publish from the COMPLETED handler, not the scheduled one: the panel
+       * must only ever sample a texture the GPU has finished writing. */
+      const int slot = _offscreenSlot;
+      [_commandBuffer addCompletedHandler:^(id<MTLCommandBuffer> _Nonnull buffer) {
+         (void)buffer;
+         ra_vision_offscreen_publish(slot);
+      }];
+   }
+   else
+#endif
    if (drawable)
    {
       /* Use addScheduledHandler to present, following Apple's recommendation.
@@ -2288,6 +2337,16 @@ - (void)swapBuffers
     * in-flight), which naturally paces us to the display refresh rate.
     * This blocking behavior is intentional for proper frame pacing. */
    _drawable = nil;
+#if defined(RA_VISION_3D)
+   /* Offscreen: nothing to pre-acquire, and re-acquiring here would burn a
+    * second ring slot per frame.  -rce / -end acquire lazily, and pacing comes
+    * from the compositor's per-frame credit instead of a blocking swapchain. */
+   if (ra_vision_3d_active())
+   {
+      _offscreenSlot = -1;
+      return;
+   }
+#endif
    _drawable = _layer.nextDrawable;
 }
 
@@ -3127,7 +3186,25 @@ - (instancetype)initWithDriver:(MetalDriver *)driver fontPath:(const char *)font
                                                                                    height:_atlas->height
                                                                                 mipmapped:NO];
 
+#if TARGET_OS_SIMULATOR
+      /* A linear (buffer-backed) texture must use MTLStorageModePrivate in the
+       * simulator, and this atlas has to stay CPU-writable — so the simulator
+       * gets an independent texture that we upload into instead of a view onto
+       * the buffer.  The buffer stays as the staging copy so -updateGlyph's
+       * incremental writes are unchanged.
+       *
+       * This is what made the font driver assert the instant any UI drew, which
+       * is why every earlier attempt at simulator validation on this port died
+       * on the render path.  Device behaviour is byte-identical: the
+       * whole branch is compiled out. */
+      _texture  = [_context.device newTextureWithDescriptor:td];
+      [_texture replaceRegion:MTLRegionMake2D(0, 0, _atlas->width, _atlas->height)
+                  mipmapLevel:0
+                    withBytes:_buffer.contents
+                  bytesPerRow:_stride];
+#else
       _texture  = [_buffer newTextureWithDescriptor:td offset:0 bytesPerRow:_stride];
+#endif
 
       if (![self _initializeState])
          return nil;
@@ -3214,6 +3291,22 @@ - (void)updateGlyph:(const struct font_glyph *)glyph
       [_buffer didModifyRange:NSMakeRange(offset, len)];
 #endif
 
+#if TARGET_OS_SIMULATOR
+      /* The simulator's atlas texture is independent of the buffer (see
+       * -initWithDriver:), so the touched rows have to be pushed across. */
+      {
+         NSUInteger y0 = (NSUInteger)glyph->atlas_offset_y;
+         NSUInteger rows = (NSUInteger)glyph->height;
+         if (y0 + rows > _atlas->height)
+            rows = (_atlas->height > y0) ? (_atlas->height - y0) : 0;
+         if (rows > 0)
+            [_texture replaceRegion:MTLRegionMake2D(0, y0, _atlas->width, rows)
+                        mipmapLevel:0
+                          withBytes:(const uint8_t *)_buffer.contents + y0 * _stride
+                        bytesPerRow:_stride];
+      }
+#endif
+
       _atlas->dirty = false;
    }
 }
@@ -3616,6 +3709,21 @@ @implementation MetalView
 - (void)keyDown:(NSEvent*)theEvent { }
 #endif
 
+#if TARGET_OS_VISION
+/* 0021: the render view's OWN layoutSubviews is the can't-miss signal for a bounds
+ * change on visionOS — VC layout callbacks (viewWill/DidLayoutSubviews) are not
+ * reliably delivered AFTER the async requestGeometryUpdate resize settles, so the
+ * drawable never tracked the new window (beacon-confirmed). UIKit runs a view's
+ * layoutSubviews on the next CA commit whenever its frame/bounds change. Re-derive
+ * the drawable here (skip-if-unchanged guarded). */
+- (void)layoutSubviews
+{
+   [super layoutSubviews];
+   extern void cocoa_vision_update_drawable(void);
+   cocoa_vision_update_drawable();
+}
+#endif
