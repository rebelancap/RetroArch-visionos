+#if defined(TARGET_OS_VISION) && TARGET_OS_VISION
+   /* overlay patch 0015 (+0018): shape the visionOS window to the applied content
+    * aspect (kills the pillarbox) — but ONLY while real content is running and the
+    * menu is closed. The default Ozone/glui menu is aspect-agnostic (it reflows to
+    * fill the window), so forcing the game's DAR — or the stale ~1:1 CORE value
+    * present at launch with no content — squishes/stretches the menu. In those
+    * states request a neutral landscape (16:9) instead. The menu-toggle funnels
+    * (retroarch_menu_running[_finished]) re-fire this event so the window flips
+    * neutral<->content on open/close. */
+   {
+      extern void cocoa_vision_window_match_aspect(float aspect, unsigned rotation);
+      extern bool content_is_inited(void);
+      bool menu_alive  = (menu_state_get_ptr()->flags & MENU_ST_FLAG_ALIVE) != 0;
+      bool use_content = content_is_inited() && !menu_alive;
+      float win_aspect = use_content ? video_st->aspect_ratio : (16.0f / 9.0f);
+      unsigned win_rot = use_content ? retroarch_get_rotation() : 0;
+      cocoa_vision_window_match_aspect(win_aspect, win_rot);
+   }
+#endif
 }
 
