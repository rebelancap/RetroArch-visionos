+   {
+      ra_vision_pre_tot = (gl->vp.full_width / 8) * (gl->vp.full_height / 8);
+      ra_vision_pre_nb  = ra_vision_probe(0,
+            gl->vp.full_width, gl->vp.full_height);
+   }
+#endif
 
