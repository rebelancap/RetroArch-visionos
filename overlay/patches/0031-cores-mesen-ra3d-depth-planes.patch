+/* ---- RA3D depth planes ---------------------------------------------------
+ * The visionOS shell places the NES picture's layers at different distances so
+ * the scene has real binocular depth.  It reads them straight out of the core
+ * (dlsym on this symbol) rather than through the libretro video callback, so
+ * RetroArch's video path — and therefore ordinary 2D output — is untouched.
+ *
+ * Returns the number of planes, far to near:
+ *   planes[0] = sprites BEHIND the background
+ *   planes[1] = background
+ *   planes[2] = sprites IN FRONT of the background
+ * Buffers are 256x240 ARGB8888, alpha 0 where nothing was drawn, owned by the
+ * core and valid until the next call.  frame_counter increments per emulated
+ * frame so the caller can skip re-uploading an unchanged frame. */
+extern "C" int mesen_ra3d_get_planes(const uint32_t **planes, unsigned *width,
+                                     unsigned *height, uint32_t *frame_counter,
+                                     float *display_aspect)
+{
+	if(!planes || !_console) return 0;
+	PPU *ppu = _console->GetPpu();
+	if(!ppu) return 0;
+	/* Core plane order is 0=bg, 1=front, 2=behind; hand it back sorted by depth. */
+	/* Hand them back sorted by depth, far to near:
+	 *   backdrop, sprites-behind, background, sprites-front */
+	static const int order[4] = { 3, 2, 0, 1 };
+	for(int i = 0; i < 4; i++) {
+		planes[i] = ppu->GetRA3DPlane(order[i]);
+		if(!planes[i]) return 0;
+	}
+	if(width)  *width  = 256;
+	if(height) *height = 240;
+	if(frame_counter) *frame_counter = ppu->GetRA3DFrameCounter();
+	/* Mesen's own reported aspect: NES pixels are not square and the region
+	 * (NTSC 8:7 vs PAL) changes it, so let the core state it rather than have
+	 * the shell guess or inherit the frontend's. 0 = shell falls back. */
+	if(display_aspect) *display_aspect = 0.0f;
+	return 4;
+}
