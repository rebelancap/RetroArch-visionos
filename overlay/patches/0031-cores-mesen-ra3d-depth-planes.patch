+/* RA3D: the background palette index for this pixel, evaluated exactly as
+ * GetPixelColor() does but ignoring sprites entirely — so the background plane
+ * has no sprite-shaped holes in it. */
+uint8_t PPU::GetBackgroundPixelColor()
+{
+	uint8_t offset = _state.XScroll;
+	uint8_t backgroundColor = 0;
+	if(_cycle > _minimumDrawBgCycle && _settings->GetBackgroundEnabled()) {
+		backgroundColor = (((_state.LowBitShift << offset) & 0x8000) >> 15) | (((_state.HighBitShift << offset) & 0x8000) >> 14);
+	}
+	return ((offset + ((_cycle - 1) & 0x07) < 8) ? _previousTile : _currentTile).PaletteOffset + backgroundColor;
+}
