+#define RA_PACE_ITERATE()    ra_pace_iterate()
+#define RA_PACE_FREE_ACTIVE  ra_pace_free
+#else
+#define RA_PACE_ITERATE()    runloop_iterate()
+#define RA_PACE_FREE_ACTIVE  false
+#endif
